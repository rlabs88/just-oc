          "*": "deny",
        },
        "glob": {
          "*": "allow",
        },
        "grep": {
          "*": "allow",
        },
        "list": {
          "*": "allow",
        },
        "lsp": {
          "*": "allow",
        },
        "question": "allow",
        "read": {
          "*": "allow",
          "*.env*": "deny",
        },
        "skill": {
          "*": "ask",
        },
